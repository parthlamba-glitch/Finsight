# FinSight Environment Configuration
# Copy this file to .env and configure your environment-specific values.

# Database
DATABASE_URL=sqlite:///./finsight.db
SQL_ECHO=false

# Authentication & JWT Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# WebAuthn / Passkey Configuration
# For local development: rp_id=localhost, origin=http://localhost:8000 (or frontend origin)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=FinSight Financial Copilot
WEBAUTHN_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5173

# Demo & Legacy Test Compatibility Mode
# When false (default), all user-scoped endpoints strictly require Bearer JWT.
# When true, unauthenticated legacy demo/test calls with explicit demo headers are permitted.
FINSIGHT_ALLOW_DEMO_UNAUTHENTICATED=false

# LLM / Gemini API Configuration
# GEMINI_API_KEY=your-gemini-api-key-here
# LLM_PROVIDER=gemini
